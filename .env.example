# API authentication
API_KEY=change-me-to-a-random-uuid

# Database (SQLite default, swap to PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./data/carrier_sales.db

# FMCSA (handled by HappyRobot platform, kept here for future direct use)
FMCSA_API_KEY=
FMCSA_MOCK_MODE=true

# CORS (comma-separated origins for the dashboard)
CORS_ORIGINS=["http://localhost:3000"]
