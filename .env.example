# API authentication (required)
# Used by HappyRobot platform and dashboard to authenticate requests
# Local default: dev-api-key | Railway: set via `railway variables set`
API_KEY=dev-api-key

# Database
# SQLite for local dev, PostgreSQL for prod
DATABASE_URL=sqlite+aiosqlite:///./data/carrier_sales.db

# CORS origins (JSON array of allowed origins)
# Local: dashboard on port 3000 | Railway: ["*"] to allow all
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Azure Blob Storage (optional — enables immutable audit trail for call events)
# Leave empty to skip blob uploads; calls are still logged to the local DB.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=carrier-sales-events
